    "sharp": "^0.34.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/yauzl": "2.10.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
